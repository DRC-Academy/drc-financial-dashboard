# ID del Google Sheet (lo sacás de la URL: .../spreadsheets/d/ESTE_ID/edit)
GOOGLE_SHEET_ID=

# Email de la Service Account de Google Cloud (termina en .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# --- Private key de la Service Account (elegí UNA de las dos opciones) ---

# OPCIÓN RECOMENDADA: la private key codificada en base64.
# Evita que se corrompan los \n y las comillas al pegarla en paneles web como
# el de variables de entorno de Vercel (que suele causar el error
# "ERR_OSSL_UNSUPPORTED / DECODER routines::unsupported").
# Generala desde el JSON de la Service Account, por ejemplo:
#   Linux/macOS:  base64 -w0 <<< "$private_key"   (o pasá el .pem/valor a base64)
#   Windows PS:   [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($privateKey))
# Si GOOGLE_PRIVATE_KEY_B64 está definida, tiene prioridad sobre GOOGLE_PRIVATE_KEY.
GOOGLE_PRIVATE_KEY_B64=

# OPCIÓN ALTERNATIVA (cruda): la private key tal cual la da Google, con \n
# literales y entre comillas dobles. Usá esta solo si no querés codificar en base64.
# Ejemplo: "-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
