# ID del Google Sheet (lo sacás de la URL: .../spreadsheets/d/ESTE_ID/edit)
GOOGLE_SHEET_ID=

# Email de la Service Account de Google Cloud (termina en .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# --- Private key de la Service Account (elegí UNA de las dos opciones) ---

# OPCIÓN RECOMENDADA: la private key codificada en base64.
# Evita que se corrompan los \n y las comillas al pegarla en paneles web como
# el de variables de entorno de Vercel (que suele causar el error
# "ERR_OSSL_UNSUPPORTED / DECODER routines::unsupported").
# Generala desde el JSON de la Service Account, por ejemplo:
#   Linux/macOS:  base64 -w0 <<< "$private_key"   (o pasá el .pem/valor a base64)
#   Windows PS:   [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($privateKey))
# Si GOOGLE_PRIVATE_KEY_B64 está definida, tiene prioridad sobre GOOGLE_PRIVATE_KEY.
GOOGLE_PRIVATE_KEY_B64=

# OPCIÓN ALTERNATIVA (cruda): la private key tal cual la da Google, con \n
# literales y entre comillas dobles. Usá esta solo si no querés codificar en base64.
# Ejemplo: "-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# --- Gasto en profesores (proyecto DRC Gestión) ---
# Necesarias para la sección "Profesores" de Situación Financiera. Sin ellas esa
# sección muestra "sin datos" y el resto del dashboard sigue funcionando igual.

# URL base del proyecto DRC Gestión (sin barra final).
DRC_API_URL=https://academy-scheduler-aqpt.vercel.app

# Secreto compartido que viaja en la cabecera X-Dashboard-Secret. Lo PROVEE DRC
# Gestión (es el valor de su propia DASHBOARD_EXTERNAL_SECRET), no se genera
# acá: si no coincide exactamente, el endpoint responde 401.
# Sólo se usa desde el servidor (src/lib/externalPayouts.ts). NUNCA le pongas el
# prefijo NEXT_PUBLIC_: eso lo publicaría en el bundle del navegador.
DASHBOARD_EXTERNAL_SECRET=

# --- Servidor MCP de KPIs (src/app/api/mcp) ---
# Token que tiene que mandar el cliente MCP en la cabecera
#   Authorization: Bearer <token>
# Sin esta variable el servidor MCP rechaza TODAS las peticiones: un fallo de
# configuración tiene que dejarlo inservible, nunca abierto.
#
# Admite VARIOS tokens separados por comas, y así se rota sin ventana de caída:
# agregás el nuevo, actualizás el cliente, y recién entonces borrás el viejo.
#   MCP_API_TOKEN=token_viejo,token_nuevo
#
# REVOCAR = cambiar este valor en Vercel y redesplegar.
# Generá uno nuevo con:
#   node -e "console.log('drcmcp_' + require('crypto').randomBytes(36).toString('base64url'))"
# NUNCA le pongas el prefijo NEXT_PUBLIC_: eso lo publicaría en el bundle.
MCP_API_TOKEN=
